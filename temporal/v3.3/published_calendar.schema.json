{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stillpoint.example/schemas/published-common-calendar-v3.3.json",
  "title": "StillPoint Common Calendar Publication v3.3",
  "type": "object",
  "required": [
    "publicationVersion",
    "calendarCoreSpecVersion",
    "version",
    "authority",
    "referenceRuleVersion",
    "referencePoint",
    "duskProtocol",
    "seasonalAnchor",
    "snapOperator",
    "ephemerisEvidence",
    "years",
    "publicationDigest"
  ],
  "properties": {
    "publicationVersion": {
      "const": "stillpoint-calendar-publication-v1"
    },
    "calendarCoreSpecVersion": {
      "const": "stillpoint-calendar-core-spec-v1"
    },
    "version": {
      "const": "stillpoint-temporal-v3.3"
    },
    "authority": {
      "type": "object",
      "required": ["id", "status"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["pilot", "enacted"]
        }
      },
      "additionalProperties": false
    },
    "referenceRuleVersion": {
      "const": "v3.3-candidate"
    },
    "referencePoint": {
      "type": "object",
      "required": ["id", "coordinateCustodyDigest"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "coordinateCustodyDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "duskProtocol": {
      "type": "object",
      "required": ["id", "sunCenterAltitudeDegrees"],
      "properties": {
        "id": {
          "const": "apparent-sunset-0.8333"
        },
        "sunCenterAltitudeDegrees": {
          "const": -0.8333
        }
      },
      "additionalProperties": false
    },
    "seasonalAnchor": {
      "type": "object",
      "required": ["event", "commonMonth", "commonDay", "ordinal"],
      "properties": {
        "event": {
          "const": "march_equinox"
        },
        "commonMonth": {
          "const": 3
        },
        "commonDay": {
          "const": 20
        },
        "ordinal": {
          "const": 80
        }
      },
      "additionalProperties": false
    },
    "snapOperator": {
      "const": "NearestLegalSpringGate"
    },
    "ephemerisEvidence": {
      "type": "object",
      "required": ["source", "sha256"],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "years": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "year",
          "openingCivilDate",
          "reconciliationDaysAfterCompletion",
          "governingMarchEquinoxUTC",
          "nextYearSpringGateCivilDate"
        ],
        "properties": {
          "year": {
            "type": "integer"
          },
          "openingCivilDate": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "reconciliationDaysAfterCompletion": {
            "enum": [0, 7]
          },
          "governingMarchEquinoxUTC": {
            "type": "string",
            "format": "date-time"
          },
          "nextYearSpringGateCivilDate": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        },
        "additionalProperties": false
      }
    },
    "publicationDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
