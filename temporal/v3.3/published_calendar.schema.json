{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stillpoint.example/schemas/published-common-calendar-v3.3.json",
  "title": "StillPoint Common Calendar Publication v3.3",
  "type": "object",
  "required": [
    "version",
    "referencePoint",
    "duskProtocol",
    "snapOperator",
    "ephemerisEvidence",
    "years",
    "publicationDigest"
  ],
  "properties": {
    "version": {
      "const": "stillpoint-temporal-v3.3"
    },
    "referencePoint": {
      "type": "object",
      "required": [
        "id",
        "coordinateCustodyDigest"
      ],
      "properties": {
        "id": {
          "const": "GROUND_ZERO"
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "coordinateCustodyDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "duskProtocol": {
      "type": "object",
      "required": [
        "id",
        "sunCenterAltitudeDegrees"
      ],
      "properties": {
        "id": {
          "const": "apparent-sunset-0.8333"
        },
        "sunCenterAltitudeDegrees": {
          "const": -0.8333
        }
      },
      "additionalProperties": false
    },
    "snapOperator": {
      "const": "NearestLegalReentry"
    },
    "ephemerisEvidence": {
      "type": "object",
      "required": [
        "source",
        "sha256"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "years": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "year",
          "openingCivilDate",
          "reconciliationDaysAfterCompletion",
          "governingMarchEquinoxUTC"
        ],
        "properties": {
          "year": {
            "type": "integer"
          },
          "openingCivilDate": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "reconciliationDaysAfterCompletion": {
            "enum": [
              0,
              7
            ]
          },
          "governingMarchEquinoxUTC": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    },
    "publicationDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
