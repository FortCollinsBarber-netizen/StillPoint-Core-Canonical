    {"role": "research", "capabilities": ["web_research", "x_research"], "granted_by": "program:0.4-stage3"},
    {"role": "builder", "capabilities": ["web_research", "code_execution"], "granted_by": "program:0.4-stage3"},
    {"role": "stillpoint", "capabilities": ["web_research"], "granted_by": "program:0.4-stage3"}
  ]
